<launch>
  <!-- 机载/仿真统一形态：本机无 namespace 前缀（与 MAVROS /mavros/* 一致），
       机间区分交给 swarm_topology_bridge 的源前缀（/<邻居>/trajectory_intent）。
       单 Master 多 UAV 场景由每机独立 ROS Master 承担隔离（见 uav_offboard_sim.launch）。 -->
  <!-- 身份参数：ROS 内统一 UAVn（也是实机 hostname）；GCS/runtime 对接层
       （backend 任务协议 / identity map）使用 A01-A15，由 executor 层映射。 -->
  <arg name="uav_id" default="UAV1"/>
  <arg name="exec_target" default="UAV1"/>

  <!-- 身份参数放全局（/uav_id、/exec_target），供 EgoSwarmDriver 与 bridge 发现。 -->
  <param name="uav_id" value="$(arg uav_id)"/>
  <param name="exec_target" value="$(arg exec_target)"/>

  <node pkg="ego_planner_driver" type="ego_planner_driver_node" name="ego_planner_driver" output="screen">
    <param name="frame_id" value="map"/>
    <!-- B-spline knot span: upstream ctrl_pt_dist/max_vel*1.5 = 0.4/1.0*1.5 = 0.6 s -->
    <param name="ts" value="0.4"/>
    <param name="max_vel" value="1.0"/>
    <param name="max_acc" value="6.0"/>
    <param name="replan_period_s" value="1.0"/>
    <!-- plan-exec A/B/C 分支阈值（implementation_plan_26082621）：到当前目标
         <0.5m 切下一关键点、推进最远 3.5m、到达最终关键点 <0.1m → COMPLETED。 -->
    <param name="reach_thresh_m" value="0.5"/>
    <param name="max_advance_dist_m" value="3.5"/>
    <param name="arrival_reach_thresh_m" value="0.1"/>
    <!-- Candidate activation-time reconciliation retries. Each retry advances
         neighbor intent epochs to the actual post-optimization activation. -->
    <param name="activation_replan_attempts" value="3"/>
    <!-- 最终目标附近（no_replan_thresh_m 内）停止时间触发重规划，让最后一段
         轨迹自然减速走完（对齐原版 fsm/thresh_no_replan_meter） -->
    <param name="no_replan_thresh_m" value="1.0"/>
    <!-- 候选 setpoint 话题（PositionTarget，relay 唯一出口，业务层不改 MAVROS 话题） -->
    <param name="setpoint_out_topic" value="/setpoint/ego"/>
    <!-- Per-aircraft clearance radius; reciprocal hard center spacing is 2x. -->
    <param name="swarm_clearance" value="0.5"/>
    <param name="planning_range" value="30.0"/>
    <param name="lambda_smooth" value="1.0"/>
    <param name="lambda_swarm" value="1.0"/>
    <!-- min-snap 重构：rebound 硬推与时间重参数化默认关闭（机间安全由执行层
         运行时距离门禁兜底）；如需 A/B 对比或回退可改 enable_rebound/
         enable_time_reparam。cruise_velocity 为滚动段末点切线巡航速度上限。 -->
    <param name="enable_rebound" value="false"/>
    <param name="enable_time_reparam" value="false"/>
    <param name="cruise_velocity" value="1.0"/>
    <param name="acceleration_limit" value="2.0"/>
    <param name="lambda_feasibility" value="0.5"/>
    <param name="setpoint_rate_hz" value="30.0"/>
    <param name="local_pose_timeout_s" value="1.0"/>
    <param name="arrival_stable_s" value="1.0"/>
    <param name="exec_timeout_margin_s" value="5.0"/>
    <param name="takeoff_height_m" value="5.0"/>
    <param name="takeoff_ascend_speed" value="1.0"/>
    <!-- Stage A: predictive supervisor records decisions only. No state,
         trajectory, intent, or setpoint behavior changes in shadow mode. -->
    <param name="safety_supervisor_mode" value="shadow"/>
    <param name="safety_supervisor_rate_hz" value="25.0"/>
    <!-- 周期碰撞检查：10Hz，本机轨迹 vs fresh 邻机轨迹，< 固定 clearance → replan
         （implementation_plan_26082602；intent 生成即发，无周期 5Hz 刷新）。 -->
    <param name="collision_check_rate_hz" value="10.0"/>
    <param name="bias_valid_s" value="120.0"/>
    <param name="safety_prediction_horizon_s" value="5.0"/>
    <param name="safety_sample_period_s" value="0.05"/>
    <param name="protected_distance_m" value="1.0"/>
    <param name="safety_control_delay_s" value="0.20"/>
    <param name="safety_compute_budget_s" value="0.05"/>
    <param name="peer_data_age_cap_s" value="2.0"/>
    <param name="emergency_decel_mps2" value="2.0"/>
    <param name="emergency_jerk_mps3" value="8.0"/>
    <param name="emergency_max_velocity_mps" value="1.5"/>
    <param name="emergency_sample_period_s" value="0.02"/>
    <param name="warning_buffer_m" value="0.35"/>
    <param name="emergency_buffer_m" value="0.10"/>
    <param name="warning_ttc_s" value="3.0"/>
    <param name="emergency_ttc_s" value="1.5"/>
    <param name="minimum_prediction_window_s" value="0.25"/>
    <param name="safety_episode_release_s" value="1.0"/>
    <!-- 对齐原版 fsm/emergency_time=1.0s：EMERGENCY 先尝试重规划，预测越界
         (ttc) 小于该值才立即受约束制动，否则交常规 replanLoop。 -->
    <param name="emergency_replan_time_s" value="1.0"/>
    <!-- 机间让路候选（SLOW/LEFT/RIGHT + right-of-way，implementation_plan_26082602 §10）：
         collisionCheckTick 检测冲突（min_clear < 1.3×clearance）→ 本机 YIELD（ID 小于
         primary peer）生成候选，cost 最小者提交。 -->
    <param name="enable_yield_candidates" value="true"/>
    <param name="yield_clearance_factor" value="1.3"/>
    <param name="yield_lateral_max_m" value="2.0"/>
    <param name="yield_slow_min_scale" value="0.3"/>
    <!-- 对齐原版 SEQUENTIAL_START：首轮规划前等待前驱无人机 intent 超时（防
         前驱缺失/失联时永久阻塞）；默认 10s。 -->
    <param name="first_plan_wait_timeout_s" value="10.0"/>
    <param name="neighbor_stale_policy" value="diagnose_only"/>
    <param name="neighbor_intent_stale_s" value="2.0"/>
    <param name="neighbor_missing_policy" value="continue_after_barrier"/>
    <param name="diagnostic_log_dir" value="/home/ub20tg/catkin_swarm6-2/runtime_logs/ego_planner"/>
    <param name="diagnostic_log_queue_size" value="2048"/>
  </node>
</launch>
