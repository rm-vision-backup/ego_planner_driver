<launch>
  <!-- 机载/仿真统一形态：本机无 namespace 前缀（与 MAVROS /mavros/* 一致），
       机间区分交给 swarm_topology_bridge 的源前缀（/<邻居>/trajectory_intent）。
       单 Master 多 UAV 场景由每机独立 ROS Master 承担隔离（见 uav_offboard_sim.launch）。 -->
  <arg name="uav_id" default="A01"/>
  <arg name="exec_target" default="UAV1"/>

  <!-- 身份参数放全局（/uav_id、/exec_target），供 EgoSwarmDriver 与 bridge 发现。 -->
  <param name="uav_id" value="$(arg uav_id)"/>
  <param name="exec_target" value="$(arg exec_target)"/>

  <node pkg="ego_planner_driver" type="ego_planner_driver_node" name="ego_planner_driver" output="screen">
    <param name="frame_id" value="map"/>
    <param name="ts" value="0.4"/>
    <param name="max_vel" value="1.0"/>
    <param name="max_acc" value="6.0"/>
    <param name="swarm_clearance" value="2.0"/>
    <param name="planning_range" value="30.0"/>
    <param name="lambda_smooth" value="1.0"/>
    <param name="lambda_swarm" value="1.0"/>
    <param name="lambda_feasibility" value="1.0"/>
    <param name="setpoint_rate_hz" value="30.0"/>
    <param name="local_pose_timeout_s" value="1.0"/>
    <param name="position_tolerance_m" value="0.2"/>
    <param name="arrival_stable_s" value="1.0"/>
    <param name="exec_timeout_margin_s" value="5.0"/>
    <!-- terminal(COMPLETED/HOLD) → IDLE 自动转换窗口（秒） -->
    <param name="terminal_to_idle_s" value="2.0"/>
    <!-- IDLE hover 目标每秒刷新频率（Hz） -->
    <param name="idle_hover_refresh_hz" value="1.0"/>
  </node>
</launch>